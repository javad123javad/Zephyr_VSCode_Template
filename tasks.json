{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (native_posix)",
            "type": "shell",
            "command": "west",
            "args": [
                "build",
                "-b",
                "native_posix",
                "-s",
                "${workspaceFolder}",
                "-d",
                "${workspaceFolder}/build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}