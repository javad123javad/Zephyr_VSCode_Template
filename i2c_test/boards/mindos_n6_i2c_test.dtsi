/*
 * BME280 environmental sensor (temperature/pressure/humidity) wired
 * to the io_i2c (i2c2) header. Found at address 0x76 (SDO -> GND)
 * during the bus scan.
 *
 * PCA9557PW,118 8-bit I2C GPIO expander wired to io_i2c, found at
 * address 0x19 (address pins: A0=VCC, A1=GND, A2=GND). Uses the
 * out-of-tree "nxp,pca9557" driver in ../pca9557_driver - see that
 * directory's README for why Zephyr's in-tree "nxp,pca95xx" driver
 * does not work with this part.
 *
 * MCP2515 SPI CAN controller wired to the io_spi (spi2) header.
 * Chip select uses the hardware NSS pin (PA11) already wired up in
 * spi2's pinctrl; INT is on PB3.
 *
 * MAX98357A I2S amp/DAC wired to the io_i2s (i2s1) header. i2s1 is
 * already enabled by the board, but its DMA channels come from
 * gpdma1, which the SoC devicetree leaves "disabled" by default and
 * no board file turns on - without this, the I2S driver fails to
 * build (DEVICE_DT_GET() on a DMA channel device that doesn't exist).
 *
 * Two MIC2026-1YM USB port power switches (one per USB port). Each
 * has an EN input (PE1/PE3, active-high, drive high to turn on the
 * 5V switch) and an OCS/FLAG# output (PB5/PB14, active-low, asserted
 * on overcurrent/thermal fault - the closest available signal to
 * "is 5V actually present and healthy"). Exposed via the standard
 * zephyr,user node rather than a custom binding, since these are
 * just plain GPIOs with no protocol/chip driver involved.
 *
 * USB1 (usbotg_hs1 / zephyr_udc0) is also exercised as a USB CDC-ACM
 * serial device (see usb_device_test.c) - it shares the same physical
 * connector as the MIC2026-switched 5V above. usb_power_test.c always
 * drives that port's EN high, so when plugging this port into a PC,
 * physically isolate/unpower the MIC2026 first to avoid two 5V
 * sources fighting on the same VBUS pin.
 *
 * SPDX-License-Identifier: Apache-2.0
 */

#include <freq.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

&gpdma1 {
	status = "okay";
};

/*
 * AXISRAM3: extra 448KB SRAM bank beyond the primary axisram1/2
 * region already used as zephyr,sram - see axisram_test.c for what
 * this demonstrates and why zephyr,sram itself can't just be
 * switched to axisram1 for "more RAM" (short version: on this
 * secure/serial-boot ("/sb") target the Boot ROM RAM-loads the whole
 * image into a fixed 511KB window at the top of the axisram1/2
 * range - that's what "axisram2" actually denotes here - and
 * anywhere else in that range is invalid during SB/FSBL boot).
 *
 * 448KB comes from the gap between axisram3/4/5/6's addresses in
 * dts/arm/st/n6/stm32n6.dtsi (0x34200000, 0x34270000, 0x342e0000,
 * 0x34350000 - each 0x70000 apart), cross-checked against an ST
 * engineer's figure of "3.75MB total across AXISRAM1-6" on the ST
 * community forum (3.75MB - 2MB for axisram1/2 = 1.75MB over 4
 * banks = 448KB each). Neither the upstream SoC dtsi nor either
 * official ST reference board (stm32n6570_dk, nucleo_n657x0_q) sets
 * reg on axisram3-6, so there's no in-tree example to copy from.
 *
 * status = "okay" is set explicitly (not relying on the default) -
 * CONFIG_STM32N6_AXISRAM's `default y if $(dt_nodelabel_enabled,...)`
 * did not turn on with axisram3 merely lacking an explicit
 * "disabled" status; it needs a literal "okay".
 */
&axisram3 {
	reg = <0x34200000 DT_SIZE_K(448)>;
	status = "okay";
};

/ {
	zephyr,user {
		usb1-en-gpios = <&gpioe 1 GPIO_ACTIVE_HIGH>;
		usb1-ocs-gpios = <&gpiob 0 GPIO_ACTIVE_LOW>;
		usb2-en-gpios = <&gpioe 3 GPIO_ACTIVE_HIGH>;
		usb2-ocs-gpios = <&gpiob 14 GPIO_ACTIVE_LOW>;
	};
};

&zephyr_udc0 {
	cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
		label = "Zephyr USB CDC-ACM";
	};
};

/* M24C64-R: 64 Kbit (8 KiB) I2C EEPROM holding the board configuration
 * settings. E0-E2 are tied low, giving address 0x50 (it is the device
 * seen at 0x50 in the io_cnf_i2c scan). 32-byte pages, 16-bit word
 * address, 5 ms maximum write cycle time (datasheet tW).
 */
&i2c1 {
	board_eeprom: eeprom@50 {
		compatible = "st,m24c64", "atmel,at24";
		reg = <0x50>;
		size = <DT_SIZE_K(8)>;
		pagesize = <32>;
		address-width = <16>;
		timeout = <5>;
	};
};

/* Customer devices go under the I/O card's port slots (mind_io): the card
 * EEPROM says which host bus and chip-select each slot uses.
 */
&mio_i2c_port0 {
	bme280: bme280@76 {
		compatible = "bosch,bme280";
		reg = <0x76>;
	};
};

/* The PCA9557 is mounted on the I/O card itself, on the IO_I2C host bus */
&i2c2 {
	io_expander: pca9557@19 {
		compatible = "nxp,pca9557";
		reg = <0x19>;
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <8>;
	};
};

&mio_spi_port0 {
	mcp2515: can@0 {
		compatible = "microchip,mcp2515";
		reg = <0x0>;
		spi-max-frequency = <DT_FREQ_M(1)>;
		osc-freq = <DT_FREQ_M(8)>;
		int-gpios = <&mio_gpios 3 GPIO_ACTIVE_LOW>; /* connector IO_GPIO3 */
		bitrate = <500000>;
		status = "okay";

		can-transceiver {
			max-bitrate = <1000000>;
		};
	};
};
