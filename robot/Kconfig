mainmenu "4WD robot"

config ROBOT_WIFI_SSID
	string "Wi-Fi network name"
	help
	  SSID of the Wi-Fi network the robot joins.

config ROBOT_WIFI_PSK
	string "Wi-Fi password"
	help
	  WPA2 passphrase of the Wi-Fi network. Leave empty for an open
	  network.

config ROBOT_AP_PSK
	string "Own network password"
	help
	  WPA2 passphrase (8-63 characters) of the network the robot opens
	  when it cannot join CONFIG_ROBOT_WIFI_SSID. Leave empty to never
	  open one.

config ROBOT_AP_FALLBACK_SEC
	int "Seconds before opening the own network"
	default 20
	help
	  How long the robot tries to join CONFIG_ROBOT_WIFI_SSID before it
	  opens its own network. Without a configured SSID it opens at once.

config ROBOT_IMU_RATE
	int "IMU sampling rate (Hz)"
	default 400
	help
	  ADXL345 output data rate: 100, 200, 400 or 800.

config ROBOT_LINK_PORT
	int "UDP port of the PC link"
	default 4244
	help
	  Drive commands, status and IMU data are exchanged with the PC app
	  on this port; see src/link.h.

config ROBOT_IMU_ACCEL_OFS_X
	int "Accelerometer zero-g reading, sensor X (mg)"
	default 0
	help
	  What the ADXL345 reads at zero g on its own X axis, subtracted from
	  every sample. Measure it with the module level, then upside down:
	  the offset is the mean of the two readings. The Y and Z options
	  work the same way.

config ROBOT_IMU_ACCEL_OFS_Y
	int "Accelerometer zero-g reading, sensor Y (mg)"
	default 0

config ROBOT_IMU_ACCEL_OFS_Z
	int "Accelerometer zero-g reading, sensor Z (mg)"
	default 0

config ROBOT_IMU_GYRO_BIAS_X
	int "Gyro bias at start-up, sensor X (milli-deg/s)"
	default 0
	help
	  Rotation rate the ITG3205 reads at rest, used until the robot has
	  measured it itself after standing still. The Y and Z options work
	  the same way.

config ROBOT_IMU_GYRO_BIAS_Y
	int "Gyro bias at start-up, sensor Y (milli-deg/s)"
	default 0

config ROBOT_IMU_GYRO_BIAS_Z
	int "Gyro bias at start-up, sensor Z (milli-deg/s)"
	default 0

config ROBOT_COLLISION_MODE
	int "Collision detection mode at start-up"
	range 0 2
	default 2
	help
	  0 off, 1 monitor (report only), 2 stop (stop the motors and latch
	  the collision inhibit until reset). The PC app can change it.

config ROBOT_COLLISION_A25_MG
	int "Collision threshold: horizontal acceleration over 25 ms (mg)"
	default 600

config ROBOT_COLLISION_VIB_MG
	int "Collision threshold: vibration RMS over 100 ms (mg)"
	default 900

config ROBOT_COLLISION_A25_TURN_MG
	int "Collision threshold while turning: acceleration over 25 ms (mg)"
	default 1000
	help
	  Spins and curves shake the robot: a spin reached 0.67 g, collisions
	  1.0 g and more.

config ROBOT_COLLISION_VIB_TURN_MG
	int "Collision threshold while turning: vibration RMS (mg), 0 = unused"
	default 0
	help
	  Spins reach 1.6 g of vibration, as much as collisions, so vibration
	  is not used while turning by default.

config ROBOT_IMU_INT2
	bool "IMU module routes A-INT to the ADXL345 INT2 output"
	help
	  GY-85 modules differ in which ADXL345 interrupt output reaches the
	  A-INT pin. Enable this if "robot imu" counts every sample as an
	  interrupt timeout.

config ROBOT_BATTERY
	bool "Battery monitoring"
	select ADC
	help
	  Measure the motor pack on GPIO34 and the board cell on GPIO35
	  through resistor dividers, show them on the web page and block
	  driving when a battery runs low. Enable only once the dividers are
	  fitted: unconnected ADC pins float and read random voltages.

if ROBOT_BATTERY

config ROBOT_BATT_MOTOR_CELLS
	int "Motor pack cells in series"
	default 3

config ROBOT_BATT_MOTOR_DIV_TOP
	int "Motor pack divider, resistor to the battery (ohm)"
	default 100000

config ROBOT_BATT_MOTOR_DIV_BOTTOM
	int "Motor pack divider, resistor to ground (ohm)"
	default 22000

config ROBOT_BATT_MOTOR_CAL
	int "Motor pack calibration (per mille)"
	default 1000
	help
	  Scale applied to the motor pack reading to correct resistor
	  tolerance: multimeter voltage / displayed voltage * 1000.

config ROBOT_BATT_BOARD_DIV_TOP
	int "Board cell divider, resistor to the battery (ohm)"
	default 100000

config ROBOT_BATT_BOARD_DIV_BOTTOM
	int "Board cell divider, resistor to ground (ohm)"
	default 100000

config ROBOT_BATT_BOARD_CAL
	int "Board cell calibration (per mille)"
	default 1000

endif # ROBOT_BATTERY

source "Kconfig.zephyr"
