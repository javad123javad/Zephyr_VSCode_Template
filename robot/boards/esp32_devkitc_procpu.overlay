 *
 * SPDX-License-Identifier: Apache-2.0
 *
 * 4WD motor driver inputs, all active low, driven by LEDC PWM channels 0-7.
 * Each motor has two inputs: "-1" drives forward, "-2" drives reverse.
 *
 *   M1-1 GPIO13 ch0   M1-2 GPIO2  ch1
 *   M2-1 GPIO14 ch2   M2-2 GPIO27 ch3
 *   M3-1 GPIO26 ch4   M3-2 GPIO25 ch5
 *   M4-1 GPIO33 ch6   M4-2 GPIO32 ch7
 */

#include <zephyr/dt-bindings/pwm/pwm.h>

#define MOTOR_PWM(ch) <&ledc0 ch PWM_HZ(1000) PWM_POLARITY_INVERTED>

/ {
	zephyr,user {
		/* M1-1, M1-2, M2-1, M2-2, M3-1, M3-2, M4-1, M4-2 */
		pwms = MOTOR_PWM(0), MOTOR_PWM(1), MOTOR_PWM(2), MOTOR_PWM(3),
		       MOTOR_PWM(4), MOTOR_PWM(5), MOTOR_PWM(6), MOTOR_PWM(7);
		/* GY-85 A-INT: ADXL345 data ready. */
		imu-int-gpios = <&gpio0 19 GPIO_ACTIVE_HIGH>;
		/* Motor pack on GPIO34, board cell on GPIO35, both via dividers. */
		io-channels = <&adc0 6>, <&adc0 7>;
	};
};

/*
 * ADC1 (adc0 here) keeps working while Wi-Fi is active, ADC2 does not. 12 dB
 * attenuation (gain 1/4) measures up to about 2.5 V.
 */
&adc0 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	channel@6 {
		reg = <6>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};

	channel@7 {
		reg = <7>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};

&pinctrl {
	i2c0_imu: i2c0_imu {
		group1 {
			pinmux = <I2C0_SDA_GPIO23>, <I2C0_SCL_GPIO22>;
			bias-pull-up;
			drive-open-drain;
			output-high;
		};
	};

	ledc0_motors: ledc0_motors {
		group1 {
			pinmux = <LEDC_CH0_GPIO13>, <LEDC_CH1_GPIO2>,
				 <LEDC_CH2_GPIO14>, <LEDC_CH3_GPIO27>,
				 <LEDC_CH4_GPIO26>, <LEDC_CH5_GPIO25>,
				 <LEDC_CH6_GPIO33>, <LEDC_CH7_GPIO32>;
			output-enable;
		};
	};
};

/* "inverted" makes every input idle high (motor off) from driver init on. */
&ledc0 {
	pinctrl-0 = <&ledc0_motors>;
	pinctrl-names = "default";
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel0@0 {
		reg = <0x0>;
		timer = <0>;
		inverted;
	};
	channel1@1 {
		reg = <0x1>;
		timer = <0>;
		inverted;
	};
	channel2@2 {
		reg = <0x2>;
		timer = <0>;
		inverted;
	};
	channel3@3 {
		reg = <0x3>;
		timer = <0>;
		inverted;
	};
	channel4@4 {
		reg = <0x4>;
		timer = <0>;
		inverted;
	};
	channel5@5 {
		reg = <0x5>;
		timer = <0>;
		inverted;
	};
	channel6@6 {
		reg = <0x6>;
		timer = <0>;
		inverted;
	};
	channel7@7 {
		reg = <0x7>;
		timer = <0>;
		inverted;
	};
};

/* GY-85 IMU on I2C0: SDA on GPIO23, SCL on GPIO22. */
&i2c0 {
	clock-frequency = <I2C_BITRATE_FAST>;
	sda-gpios = <&gpio0 23 GPIO_OPEN_DRAIN>;
	scl-gpios = <&gpio0 22 GPIO_OPEN_DRAIN>;
	pinctrl-0 = <&i2c0_imu>;
	pinctrl-names = "default";
};

/* SPI3 is routed to GPIO5/18/19/23 on this board; the IMU uses GPIO19 and 23. */
&spi3 {
	status = "disabled";
};

/* SPI2 is routed to GPIO12/13/14/15 on this board; GPIO13/14 drive M1/M2. */
&spi2 {
	status = "disabled";
};
