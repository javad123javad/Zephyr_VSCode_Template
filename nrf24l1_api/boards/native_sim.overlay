&spi0 {
		status = "okay";

        nrf24l1:nrf24l1@0{
            compatible = "nordic,nrf24l1";
            reg = <0x0>;
            spi-max-frequency = <80000000>;

            ce-gpios = <&gpio0 1 GPIO_ACTIVE_HIGH>;
            irq-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
            csn-gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
        };
		
};