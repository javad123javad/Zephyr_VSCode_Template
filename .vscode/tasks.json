{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "zephyr:sim:build",
            "type": "shell",
            "command": "west",
            "args": [
                "build",
                "-p",
                "-b",
                "${config:bsp.board-sim}",
                "-s",
                "${workspaceFolder}",
                "-d",
                "${workspaceFolder}/build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "zephyr:stm32f103:build",
            "type": "shell",
            "command": "west",
            "args": [
                "build",
                "-p",
                "-b",
                "${config:bsp.board-stm32f103}",
                "-s",
                "${workspaceFolder}",
                "-d",
                "${workspaceFolder}/build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Run Sim",
            "type": "shell",
            "command": "west",
            "args": [
                "build",
                "-t",
                "run",
                "-d",
                "${workspaceFolder}/build"
            ],
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            }
        }
    ]
}